+#include "gfx_gles_shader.h"
+#include <assert.h>
+#include <string.h>
+#include <stdio.h>
+int main(void) {
+    char vs[2048]="#version 320 es\nnoperspective out vec4 vInput1;\nnoperspective out vec2 vTexCoord0;\nvoid main(){vInput1=a; vTexCoord0=b; gl_Position=p;}\n";
+    char fs[2048]="#version 320 es\nnoperspective in vec4 vInput1;\nnoperspective in vec2 vTexCoord0;\nvoid main(){f=vInput1;}\n";
+    assert(mdkr_gles_affine_shader(vs,sizeof(vs),fs,sizeof(fs)));
+    assert(!strstr(vs,"noperspective") && !strstr(fs,"noperspective"));
+    assert(strstr(vs,"vInput1 *= gl_Position.w;") && strstr(vs,"vTexCoord0 *= gl_Position.w;"));
+    assert(strstr(fs,"#define vInput1 (mdkr_aff_vInput1 * gl_FragCoord.w)"));
+    assert(strstr(vs,"out vec4 mdkr_aff_vInput1;"));
+    assert(strstr(fs,"in vec4 mdkr_aff_vInput1;"));
+    char badvs[80]="noperspective out vec4 v;void main(){}", badfs[80]="void main(){}";
+    assert(!mdkr_gles_affine_shader(badvs,sizeof(badvs),badfs,sizeof(badfs)));
+    char smallvs[80]="noperspective out vec4 v;void main(){}", smallfs[40]="noperspective in vec4 v;";
+    assert(!mdkr_gles_affine_shader(smallvs,sizeof(smallvs),smallfs,sizeof(smallfs)));
+    /* Perspective interpolation of attr*w, multiplied by interpolated 1/w,
+       must equal affine interpolation even when clip-space depths differ. */
+    double b[]={.2,.3,.5}, w[]={1,2,5}, a[]={.1,.9,.4};
+    double numerator=0,denominator=0,expected=0;
+    for(int i=0;i<3;i++){ numerator+=b[i]*(a[i]*w[i])/w[i]; denominator+=b[i]/w[i]; expected+=b[i]*a[i]; }
+    double delta=numerator/denominator*denominator-expected;
+    assert(delta<1e-12 && delta>-1e-12);
+    puts("GLES affine shader tests passed");
+}
