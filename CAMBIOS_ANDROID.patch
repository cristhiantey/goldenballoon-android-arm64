+#include "gfx_gles_shader.h"
+#include <stdio.h>
+#include <string.h>
+
+static bool splice(char *s, size_t cap, char *at, size_t remove, const char *insert) {
+    size_t n = strlen(s), add = strlen(insert), offset = (size_t)(at-s);
+    if (offset > n || remove > n-offset || n-remove+add >= cap) return false;
+    memmove(at+add,at+remove,n-offset-remove+1);
+    memcpy(at,insert,add); return true;
+}
+bool mdkr_gles_affine_shader(char *vs, size_t vcap, char *fs, size_t fcap) {
+    char *at;
+    while ((at = strstr(vs, "noperspective out ")) != NULL) {
+        char type[16], name[64], old[128], replacement[320], multiply[128];
+        char *end = strchr(at, ';');
+        if (!end || sscanf(at,"noperspective out %15s %63[^;];",type,name)!=2) return false;
+        snprintf(old,sizeof(old),"noperspective in %s %s;",type,name);
+        char *input = strstr(fs,old);
+        if (!input) return false;
+        snprintf(replacement,sizeof(replacement),
+            "in %s mdkr_aff_%s;\n#define %s (mdkr_aff_%s * gl_FragCoord.w)\n",
+            type,name,name,name);
+        if (!splice(fs,fcap,input,strlen(old),replacement)) return false;
+        snprintf(replacement,sizeof(replacement),
+            "out %s mdkr_aff_%s;\n#define %s mdkr_aff_%s\n",type,name,name,name);
+        if (!splice(vs,vcap,at,(size_t)(end-at)+1,replacement)) return false;
+        // The generated vertex main is the final function in the source.
+        char *close = strrchr(vs,'}');
+        if (!close) return false;
+        snprintf(multiply,sizeof(multiply),"%s *= gl_Position.w;\n",name);
+        if (!splice(vs,vcap,close,0,multiply)) return false;
+    }
+    return true;
+}
