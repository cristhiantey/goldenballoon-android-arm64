+/* Android entry, strict ROM validation and atomic UI->engine input. */
+#include <jni.h>
+#include <SDL.h>
+#include <SDL_system.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include "android_bridge.h"
+#include "rom_validation.h"
+
+_Static_assert(sizeof(void *) == 8, "Android build must be LP64");
+static _Atomic uint32_t touch_state;
+void mdkr_android_read_touch(uint16_t *buttons, int8_t *x, int8_t *y) {
+    uint32_t value = atomic_load_explicit(&touch_state, memory_order_relaxed);
+    *buttons = (uint16_t)value;
+    *x = (int8_t)(value >> 16); *y = (int8_t)(value >> 24);
+}
+JNIEXPORT void JNICALL Java_org_goldenballoon_mobile_GameActivity_nativeTouch(
+    JNIEnv *env, jclass cls, jint buttons, jint x, jint y) {
+    (void)env; (void)cls;
+    if (x < -80) x = -80; if (x > 80) x = 80;
+    if (y < -80) y = -80; if (y > 80) y = 80;
+    uint32_t value = (uint16_t)buttons | ((uint32_t)(uint8_t)x << 16)
+                   | ((uint32_t)(uint8_t)y << 24);
+    atomic_store_explicit(&touch_state, value, memory_order_relaxed);
+}
+JNIEXPORT jstring JNICALL Java_org_goldenballoon_mobile_LauncherActivity_nativeValidate(
+    JNIEnv *env, jclass cls, jstring path) {
+    (void)cls;
+    const char *name = (*env)->GetStringUTFChars(env, path, NULL);
+    if (!name) return NULL;
+    FILE *f = fopen(name, "rb");
+    (*env)->ReleaseStringUTFChars(env, path, name);
+    if (!f) return (*env)->NewStringUTF(env, "No se puede abrir la ROM.");
+    uint8_t *bytes = malloc(DKR_ROM_SIZE_BYTES);
+    if (!bytes) { fclose(f); return (*env)->NewStringUTF(env, "Memoria insuficiente."); }
+    size_t n = fread(bytes, 1, DKR_ROM_SIZE_BYTES, f);
+    int extra = fgetc(f), io_error = ferror(f);
+    fclose(f);
+    DkrRomValidation result;
+    int valid = 0;
+    if (!io_error && n == DKR_ROM_SIZE_BYTES && extra == EOF)
+        valid = dkr_rom_validate_image(bytes, (uint32_t)n, "ROM", NULL, &result);
+    free(bytes);
+    if (io_error || n != DKR_ROM_SIZE_BYTES || extra != EOF)
+        return (*env)->NewStringUTF(env, "La ROM debe tener exactamente 12 MiB, sin comprimir.");
+    return valid ? NULL : (*env)->NewStringUTF(env, result.message);
+}
+int mdkr64_headless_main(int argc, char **argv);
+JNIEXPORT int SDL_main(int argc, char **argv);
+JNIEXPORT int SDL_main(int argc, char **argv) {
+    const char *root = SDL_AndroidGetInternalStoragePath();
+    if (!root || chdir(root)) {
+        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "Golden Balloon", "No se puede abrir el almacenamiento interno.", NULL);
