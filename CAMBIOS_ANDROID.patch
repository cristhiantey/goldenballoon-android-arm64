+#!/usr/bin/env python3
+"""SDK-only packaging: CMake -> javac -> D8 -> aapt2 -> zipalign -> apksigner.
+No Gradle/Maven required. Imported by build.py --sdk-only.
+"""
+import os
+from pathlib import Path
+import platform
+import shutil
+import zipfile
+import xml.etree.ElementTree as ET
+
+from build import ROOT, NDK, TOOLS, run
+from verify_apk import verify
+
+def build_sdk(sdk, jobs=2, release=False, native_dir=None):
+    windows=os.name=='nt'
+    host={'Linux':'linux-x86_64','Darwin':'darwin-x86_64','Windows':'windows-x86_64'}[platform.system()]
+    suffix='.exe' if windows else ''
+    build_tools=sdk/'build-tools/35.0.0'
+    java_home=os.environ.get('JAVA_HOME')
+    def java_tool(name):
+        return Path(java_home)/'bin'/(name+suffix) if java_home else name
+    ndk=sdk/'ndk'/NDK
+    llvm=ndk/'toolchains/llvm/prebuilt'/host
+    cmake=sdk/'cmake/3.22.1/bin'/('cmake'+suffix)
+    ninja=sdk/'cmake/3.22.1/bin'/('ninja'+suffix)
+    work=ROOT/'out/sdk-package';work.mkdir(parents=True,exist_ok=True)
+    native=Path(native_dir).resolve() if native_dir else ROOT/'out/native-arm64'
+    run([cmake,'-S',ROOT,'-B',native,'-G','Ninja',f'-DCMAKE_MAKE_PROGRAM={ninja}',f'-DCMAKE_TOOLCHAIN_FILE={ndk}/build/cmake/android.toolchain.cmake','-DANDROID_ABI=arm64-v8a','-DANDROID_PLATFORM=android-26','-DANDROID_STL=c++_shared','-DCMAKE_BUILD_TYPE=RelWithDebInfo'])
+    run([cmake,'--build',native,'--target','mdkr64','-j',jobs])
+    app=ROOT/'android/app/src/main'
+    android_jar=sdk/'platforms/android-35/android.jar'
+    ns='http://schemas.android.com/apk/res/android';ET.register_namespace('android',ns)
+    manifest=ET.parse(app/'AndroidManifest.xml');root=manifest.getroot()
+    root.set('package','org.goldenballoon.mobile')
+    root.set('{'+ns+'}versionCode','1');root.set('{'+ns+'}versionName','1.7.0-arm64.1')
+    application=root.find('application')
+    application.set('{'+ns+'}debuggable','false' if release else 'true')
+    application.set('{'+ns+'}extractNativeLibs','false')
+    application.find('provider').set('{'+ns+'}authorities','org.goldenballoon.mobile.files')
+    manifest.write(work/'AndroidManifest.xml',encoding='utf-8',xml_declaration=True)
+    resources=work/'resources.zip'
+    run([build_tools/('aapt2'+suffix),'compile','--dir',app/'res','-o',resources])
+    gen=work/'generated';gen.mkdir(exist_ok=True)
+    unsigned=work/'unsigned.apk'
+    run([build_tools/('aapt2'+suffix),'link','-I',android_jar,'--manifest',work/'AndroidManifest.xml','--min-sdk-version','26','--target-sdk-version','35','--java',gen,'-o',unsigned,resources])
+    classes=work/'classes'
+    if classes.exists(): shutil.rmtree(classes)
+    classes.mkdir()
+    sources=list((app/'java').rglob('*.java'))+list((ROOT/'third_party/SDL2/android-project/app/src/main/java').rglob('*.java'))+list(gen.rglob('*.java'))
+    source_list=work/'sources.txt'
+    source_list.write_text('\n'.join('"'+str(p).replace('\\','/')+'"' for p in sources))
+    run([java_tool('java'),'-m','jdk.compiler/com.sun.tools.javac.Main','-encoding','UTF-8','--release','8','-classpath',android_jar,'-d',classes,'@'+str(source_list)])
+    jar=work/'classes.jar'
+    with zipfile.ZipFile(jar,'w',zipfile.ZIP_DEFLATED) as z:
+        for f in sorted(classes.rglob('*.class')): z.write(f,f.relative_to(classes).as_posix())
+    dex=work/'dex';dex.mkdir(exist_ok=True)
+    for f in dex.glob('*.dex'): f.unlink()
+    # Call D8's Java entry directly, including on Windows (no .bat quoting).
+    run([java_tool('java'),'-cp',build_tools/'lib/d8.jar','com.android.tools.r8.D8','--min-api','26','--lib',android_jar,'--output',dex,jar])
+    libdir=work/'lib';libdir.mkdir(exist_ok=True)
+    sources=[native/'libmain.so',native/'sdl2/libSDL2.so',llvm/'sysroot/usr/lib/aarch64-linux-android/libc++_shared.so']
+    symbols=ROOT/'out/GoldenBalloon-arm64-symbols.zip'
+    with zipfile.ZipFile(symbols,'w',zipfile.ZIP_DEFLATED) as z:
+        for src in sources[:2]: z.write(src,src.name)
+    with zipfile.ZipFile(unsigned,'a') as z:
+        for f in sorted(dex.glob('*.dex')): z.write(f,f.name,compress_type=zipfile.ZIP_DEFLATED)
+        for src in sources:
+            copy=libdir/src.name;shutil.copy2(src,copy)
+            run([llvm/'bin'/('llvm-strip'+suffix),'--strip-unneeded',copy])
+            z.write(copy,'lib/arm64-v8a/'+copy.name,compress_type=zipfile.ZIP_STORED)
+    aligned=work/'aligned.apk'
+    run([build_tools/('zipalign'+suffix),'-P','16','-f','4',unsigned,aligned])
+    out=ROOT/'out'/('GoldenBalloon-arm64-release-unsigned.apk' if release else 'GoldenBalloon-arm64-debug.apk')
+    if release: shutil.copy2(aligned,out)
+    else:
+        # Stable local debug key across builds, never bundled in the source ZIP.
+        key=TOOLS/'goldenballoon-debug.keystore';key.parent.mkdir(parents=True,exist_ok=True)
+        if not key.exists():
+            run([java_tool('keytool'),'-genkeypair','-keystore',key,'-alias','androiddebugkey','-storepass','android','-keypass','android','-keyalg','RSA','-keysize','2048','-validity','10000','-dname','CN=Android Debug,O=Android,C=US'])
+        run([java_tool('java'),'-jar',build_tools/'lib/apksigner.jar','sign','--ks',key,'--ks-key-alias','androiddebugkey','--ks-pass','pass:android','--key-pass','pass:android','--out',out,aligned])
+        run([java_tool('java'),'-jar',build_tools/'lib/apksigner.jar','verify','--verbose',out])
+    run([build_tools/('zipalign'+suffix),'-c','-P','16','4',out])
+    verify(out)
+    print('APK:',out,'\nNative symbols:',symbols)
