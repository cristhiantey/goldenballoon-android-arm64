+package org.goldenballoon.mobile;
+
+import android.app.*;
+import android.content.*;
+import android.net.Uri;
+import android.os.Bundle;
+import android.widget.*;
+import java.io.*;
+import java.nio.file.*;
+import java.util.concurrent.*;
+import java.util.zip.*;
+
+public final class LauncherActivity extends Activity {
+    private static final int PICK_ROM = 10;
+    private final ExecutorService io = Executors.newSingleThreadExecutor();
+    private TextView status;
+    private Button play, select;
+    private boolean busy;
+    private static native String nativeValidate(String path);
+    static { System.loadLibrary("c++_shared"); System.loadLibrary("SDL2"); System.loadLibrary("main"); }
+    private File rom() { return new File(getFilesDir(), "game.rom"); }
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        LinearLayout box = new LinearLayout(this); box.setOrientation(LinearLayout.VERTICAL);
+        box.setPadding(32, 48, 32, 24);
+        ScrollView scroll = new ScrollView(this); scroll.addView(box); setContentView(scroll);
+        TextView title = new TextView(this); title.setText("Golden Balloon\nAndroid ARM64"); title.setTextSize(28); box.addView(title);
+        status = new TextView(this); status.setTextSize(16); box.addView(status);
+        select = add(box, "Importar ROM (.z64, .v64, .n64)", () -> {
+            Intent pick = new Intent(Intent.ACTION_OPEN_DOCUMENT).setType("*/*").addCategory(Intent.CATEGORY_OPENABLE);
+            startActivityForResult(pick, PICK_ROM);
+        });
+        play = add(box, "Jugar", this::validateAndPlay);
+        TextView label = new TextView(this); label.setText("Límite de presentación"); box.addView(label);
+        Spinner fps = new Spinner(this);
+        String[] rates = {"30", "60", "120"};
+        fps.setAdapter(new ArrayAdapter<>(this, android.R.layout.simple_spinner_dropdown_item, rates));
+        int saved = getPreferences(0).getInt("fps", 0); fps.setSelection(saved);
+        fps.setOnItemSelectedListener(new android.widget.AdapterView.OnItemSelectedListener() {
+            public void onNothingSelected(android.widget.AdapterView<?> p) {}
+            public void onItemSelected(android.widget.AdapterView<?> p, android.view.View v, int n, long id) {
+                getPreferences(0).edit().putInt("fps", n).apply();
+            }
+        }); box.addView(fps);
+        add(box, "Compartir registros", () -> export(false));
+        add(box, "Exportar partidas guardadas", () -> export(true));
+        TextView notes = new TextView(this);
+        notes.setText("Requiere OpenGL ES 3.2. Usa tu ROM US 1.1 o EU 1.1 de 12 MiB. Los datos se leen de la ROM en el teléfono.\n\nTáctil y mandos compatibles con SDL. 60/120 FPS dependen del dispositivo y la pantalla. El port conserva la simulación original."); box.addView(notes);
+        refresh();
+    }
+    private Button add(LinearLayout box, String text, Runnable action) {
+        Button b = new Button(this); b.setText(text); b.setOnClickListener(v -> action.run()); box.addView(b); return b;
+    }
+    private void refresh() {
+        play.setEnabled(!busy && rom().isFile()); select.setEnabled(!busy);
+        if (!busy) status.setText(rom().isFile() ? "ROM importada. Lista para validar e iniciar." : "Selecciona tu ROM para comenzar.");
+    }
+    private void fail(Exception ex) { busy = false; refresh(); new AlertDialog.Builder(this).setTitle("No se pudo completar").setMessage(ex.getMessage()).setPositiveButton("Aceptar", null).show(); }
+    @Override protected void onActivityResult(int request, int result, Intent data) {
+        super.onActivityResult(request, result, data);
+        if (request != PICK_ROM || result != RESULT_OK || data == null || data.getData() == null) return;
+        Uri uri = data.getData(); busy = true; refresh(); status.setText("Copiando y verificando la ROM…");
+        io.execute(() -> {
+            File temp = new File(getFilesDir(), "import.tmp");
+            try {
+                try (InputStream in = getContentResolver().openInputStream(uri); FileOutputStream out = new FileOutputStream(temp)) {
+                    if (in == null) throw new IOException("No se pudo leer el documento.");
+                    byte[] b = new byte[65536]; int n; long total = 0;
+                    while ((n = in.read(b)) != -1) {
+                        total += n; if (total > 12582912L) throw new IOException("La ROM supera 12 MiB. Selecciona el archivo sin ZIP.");
+                        out.write(b, 0, n);
+                    } out.getFD().sync();
+                }
+                String error = nativeValidate(temp.getAbsolutePath());
+                if (error != null) throw new IOException(error);
+                Files.move(temp.toPath(), rom().toPath(), StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+                runOnUiThread(() -> { busy = false; refresh(); });
+            } catch (Exception ex) { temp.delete(); runOnUiThread(() -> fail(ex)); }
+        });
+    }
+    private void validateAndPlay() {
+        ActivityManager am = (ActivityManager)getSystemService(ACTIVITY_SERVICE);
+        if (am.getDeviceConfigurationInfo().reqGlEsVersion < 0x00030002) {
+            fail(new IOException("Este port requiere OpenGL ES 3.2.")); return;
+        }
+        busy = true; refresh(); status.setText("Verificando integridad…");
+        int fps = new int[]{30,60,120}[getPreferences(0).getInt("fps",0)];
+        io.execute(() -> {
+            String error = nativeValidate(rom().getAbsolutePath());
+            runOnUiThread(() -> {
+                busy = false; refresh();
+                if (error != null) { fail(new IOException(error)); return; }
+                startActivity(new Intent(this, GameActivity.class).putExtra("fps", fps));
+            });
+        });
+    }
+    private void export(boolean saves) {
+        io.execute(() -> {
+            try {
+                File dir = new File(getCacheDir(), "exports"); if (!dir.exists() && !dir.mkdirs()) throw new IOException("No se pudo crear la exportación.");
+                File out = new File(dir, saves ? "goldenballoon-saves.zip" : "goldenballoon-logs.zip");
+                try (ZipOutputStream z = new ZipOutputStream(new FileOutputStream(out))) {
+                    if (saves) zipDir(z, new File(getFilesDir(), "saves"), "saves/");
+                    else for (String n : new String[]{"session.log", "session-previous.log"}) zipFile(z, new File(getFilesDir(), n), n);
+                }
+                Uri uri = new Uri.Builder().scheme("content").authority(getPackageName()+".files").appendPath(out.getName()).build();
+                runOnUiThread(() -> startActivity(Intent.createChooser(new Intent(Intent.ACTION_SEND).setType("application/zip").putExtra(Intent.EXTRA_STREAM, uri).addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION), "Compartir")));
+            } catch (Exception ex) { runOnUiThread(() -> fail(ex)); }
+        });
+    }
+    private void zipDir(ZipOutputStream z, File dir, String prefix) throws IOException {
+        File[] files = dir.listFiles(); if (files == null) return;
+        for (File f : files) { if (f.isDirectory()) zipDir(z,f,prefix+f.getName()+"/"); else zipFile(z,f,prefix+f.getName()); }
+    }
+    private void zipFile(ZipOutputStream z, File f, String name) throws IOException {
+        if (!f.isFile()) return; z.putNextEntry(new ZipEntry(name));
+        try (InputStream in = new FileInputStream(f)) { byte[] b = new byte[65536]; int n; while ((n=in.read(b)) != -1) z.write(b,0,n); } z.closeEntry();
+    }
+    @Override protected void onDestroy() { io.shutdown(); super.onDestroy(); }
+}
