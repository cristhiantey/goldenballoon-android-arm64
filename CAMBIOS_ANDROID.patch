+TOOLS = Path(os.environ.get('GB_BUILD_TOOLS', str(ROOT / '.build-tools'))).resolve()
+SDL_VERSION = '2.32.8'
+GRADLE_VERSION = '8.9'
+NDK = '28.2.13676358'
+HB = '36cb489cb02ce4b92099669ba9f9bea348eff93f'
+SB = 'cfe430e7375a7845b679adae9d51dac6deaa8858'
+DEPENDENCIES = [
+    (f'SDL2-{SDL_VERSION}.tar.gz', f'https://www.libsdl.org/release/SDL2-{SDL_VERSION}.tar.gz', '0ca83e9c9b31e18288c7ec811108e58bac1f1bb5ec6577ad386830eac51c787e'),
+    (f'harfbuzz-{HB}.tar.gz', f'https://github.com/harfbuzz/harfbuzz/archive/{HB}.tar.gz', '0afa12c8ef4bc4ffebd99e5d2a4a2c56dfe329c661feda08a9bc878b7352be89'),
+    (f'sheenbidi-{SB}.tar.gz', f'https://github.com/Tehreer/SheenBidi/archive/{SB}.tar.gz', '9546f423820d4618c704a30c51c191b0b002aa79100e0ec34cb2cf461fd6353e'),
+]
+
+def sha(path):
+    h = hashlib.sha256()
+    with path.open('rb') as f:
+        for b in iter(lambda: f.read(1024*1024), b''): h.update(b)
+    return h.hexdigest()
+
+def download(name, url, digest, directory=CACHE):
+    directory.mkdir(parents=True, exist_ok=True)
+    dest = directory / name
+    if dest.exists() and sha(dest) == digest: return dest
+    tmp = dest.with_suffix(dest.suffix+'.partial')
+    print('Downloading', name, flush=True)
+    try:
+        with urllib.request.urlopen(url, timeout=120) as src, tmp.open('wb') as out:
+            shutil.copyfileobj(src, out)
+        if sha(tmp) != digest: raise RuntimeError(f'SHA-256 mismatch: {name}')
+        tmp.replace(dest)
+    finally:
+        tmp.unlink(missing_ok=True)
+    return dest
+
+def unpack_zip(archive, directory):
