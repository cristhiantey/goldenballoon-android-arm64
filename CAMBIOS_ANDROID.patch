+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--prepare',action='store_true',help='Only unpack and verify source dependencies')
+    parser.add_argument('--install-sdk',action='store_true',help='Install pinned Linux SDK/NDK and accept Android SDK licenses')
+    parser.add_argument('--sdk-only',action='store_true',help='Build entirely with SDK/NDK tools, without Gradle or Maven')
+    parser.add_argument('--native-build-dir',type=Path,help='Existing CMake tree for --sdk-only')
+    parser.add_argument('--release',action='store_true',help='Build unsigned release APK (debug is installable by default)')
+    parser.add_argument('--jobs',type=int,default=2)
