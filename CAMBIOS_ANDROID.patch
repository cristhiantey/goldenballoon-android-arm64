+            for member in t.getmembers():
+                p = Path(member.name)
+                if p.is_absolute() or '..' in p.parts or member.issym() or member.islnk():
+                    raise RuntimeError('Unsafe SDL archive member')
+            t.extractall(sdl.parent)
+        (sdl.parent/f'SDL2-{SDL_VERSION}').rename(sdl)
+    print('SDL2, HarfBuzz and SheenBidi ready (verified SHA-256).', flush=True)
+
+def run(args, **kw):
+    print('+', ' '.join(map(str,args)), flush=True)
+    subprocess.run(list(map(str,args)), check=True, **kw)
+
+def gradle():
+    executable = TOOLS/f'gradle-{GRADLE_VERSION}'/'bin'/('gradle.bat' if os.name=='nt' else 'gradle')
+    if not executable.exists():
+        arc=download(f'gradle-{GRADLE_VERSION}-bin.zip',f'https://services.gradle.org/distributions/gradle-{GRADLE_VERSION}-bin.zip','d725d707bfabd4dfdc958c624003b3c80accc03f7037b5122c4b1d0ef15cecab',TOOLS)
+        unpack_zip(arc,TOOLS)
+    if os.name!='nt': executable.chmod(0o755)
