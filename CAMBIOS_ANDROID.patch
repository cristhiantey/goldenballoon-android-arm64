+package org.goldenballoon.mobile;
+
+import android.content.Context;
+import android.graphics.*;
+import android.view.*;
+import java.util.*;
+
+/** Multi-pointer controls. One atomic snapshot prevents mixed-axis samples. */
+final class TouchControls extends View {
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Map<Integer, PointF> pointers = new HashMap<>();
+    private int buttons, stickId = -1;
+    private float sx, sy, radius, unit;
+    // Coordinates are expressed as width/height fractions; size follows height.
+    private final float[][] keys = {
+        {.91f,.70f,0x8000}, {.80f,.83f,0x4000}, // A, B
+        {.91f,.36f,0x0010}, {.77f,.36f,0x2000}, // R, Z
+        {.08f,.20f,0x0020}, {.50f,.12f,0x1000}, // L, Start
+        {.68f,.56f,0x0008}, {.68f,.86f,0x0004}, // C up/down
+        {.62f,.71f,0x0002}, {.74f,.71f,0x0001}  // C left/right
+    };
+    private final String[] names = {"A", "B", "R", "Z", "L", "START", "C↑", "C↓", "C←", "C→"};
+    TouchControls(Context c) { super(c); setFocusable(false); setContentDescription("Controles táctiles del juego"); }
+    void reset() { pointers.clear(); stickId=-1; buttons=0; sx=sy=0; GameActivity.nativeTouch(0,0,0); invalidate(); }
+    @Override protected void onSizeChanged(int w,int h,int oldw,int oldh) { unit=Math.min(h,w*.56f); radius=unit*.14f; }
+    @Override public boolean onTouchEvent(MotionEvent e) {
+        int action=e.getActionMasked(), changed=e.getActionIndex();
+        if (action==MotionEvent.ACTION_CANCEL) { reset(); return true; }
+        pointers.clear();
+        for(int i=0;i<e.getPointerCount();i++) {
+            if ((action==MotionEvent.ACTION_UP || action==MotionEvent.ACTION_POINTER_UP) && i==changed) {
+                if(e.getPointerId(i)==stickId) stickId=-1; continue;
+            }
+            pointers.put(e.getPointerId(i),new PointF(e.getX(i),e.getY(i)));
+        }
+        buttons=0; sx=sy=0;
+        float cx=getWidth()*.16f, cy=getHeight()*.70f;
+        for(Map.Entry<Integer,PointF> entry:pointers.entrySet()) {
+            PointF p=entry.getValue();
+            if (stickId<0 && p.x<getWidth()*.38f && p.y>getHeight()*.38f) stickId=entry.getKey();
+            if (entry.getKey()==stickId) {
+                float dx=(p.x-cx)/radius,dy=(cy-p.y)/radius;
+                float len=(float)Math.sqrt(dx*dx+dy*dy);
+                if(len>.12f) { sx=dx/Math.max(1,len); sy=dy/Math.max(1,len); }
+            } else {
+                for(float[] k:keys) if(Math.hypot(p.x-getWidth()*k[0],p.y-getHeight()*k[1])<unit*.065f) buttons|=(int)k[2];
+            }
+        }
+        GameActivity.nativeTouch(buttons,Math.round(sx*80),Math.round(sy*80)); invalidate(); return true;
+    }
+    @Override protected void onDraw(Canvas c) {
+        super.onDraw(c); float cx=getWidth()*.16f,cy=getHeight()*.70f;
+        paint.setColor(0x50708090); c.drawCircle(cx,cy,radius,paint);
+        paint.setColor(0xAAFFFFFF); c.drawCircle(cx+sx*radius*.65f,cy-sy*radius*.65f,radius*.34f,paint);
+        paint.setTextAlign(Paint.Align.CENTER); paint.setTextSize(unit*.032f);
+        for(int i=0;i<keys.length;i++) {
+            float[] k=keys[i]; float x=getWidth()*k[0],y=getHeight()*k[1];
+            paint.setColor((buttons&(int)k[2])!=0 ? 0xCC3595FF:0x60708090); c.drawCircle(x,y,unit*.057f,paint);
+            paint.setColor(Color.WHITE); c.drawText(names[i],x,y-(paint.ascent()+paint.descent())/2,paint);
+        }
+    }
+}
