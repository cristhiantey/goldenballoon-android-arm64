+#!/usr/bin/env python3
+"""Fail if the APK lacks required ARM64 ELFs or uses <16 KiB LOAD alignment."""
+import struct
+import sys
+import zipfile
+
+def verify(path):
+    with zipfile.ZipFile(path) as z:
+        libs=[n for n in z.namelist() if n.startswith('lib/') and n.endswith('.so')]
+        expected={'lib/arm64-v8a/libmain.so','lib/arm64-v8a/libSDL2.so','lib/arm64-v8a/libc++_shared.so'}
+        if not expected.issubset(libs): raise ValueError(f'Missing libraries: {expected-set(libs)}')
+        for name in libs:
+            if not name.startswith('lib/arm64-v8a/'): raise ValueError('Unexpected ABI: '+name)
+            data=z.read(name)
+            if data[:6]!=b'\x7fELF\x02\x01': raise ValueError('Not ELF64 little endian: '+name)
+            if struct.unpack_from('<H',data,18)[0]!=183: raise ValueError('Not AArch64: '+name)
+            off=struct.unpack_from('<Q',data,32)[0]
+            size,count=struct.unpack_from('<HH',data,54)
+            for i in range(count):
+                header=struct.unpack_from('<IIQQQQQQ',data,off+i*size)
+                if header[0]==1 and header[7]<16384: raise ValueError('LOAD alignment <16KiB: '+name)
+            print('PASS ARM64 / 16KiB ELF:',name)
+    print('APK structural verification passed; device execution is a separate check.')
+if __name__=='__main__': verify(sys.argv[1])
