+        parent=sdk/'cmdline-tools'; parent.mkdir(parents=True,exist_ok=True)
+        unpack_zip(arc,parent); (parent/'cmdline-tools').rename(parent/'latest')
+        for f in (parent/'latest/bin').iterdir(): f.chmod(0o755)
+    # --install-sdk explicitly requests installation and acceptance of SDK licenses.
+    run([manager, f'--sdk_root={sdk}', '--licenses'],input='y\n'*100,text=True)
